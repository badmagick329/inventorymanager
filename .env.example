SECRET_KEY=replace-with-a-django-secret
ENGINE=django.db.backends.postgresql
DB_NAME=inventorymanager
DB_USER=inventorymanager
DB_PASSWORD=replace-with-db-password
DB_PORT=5432
DB_HOST=localhost
DB_TEST_NAME=inventorymanager_test
DB_TEST_USER=inventorymanager_test
DB_TEST_PASSWORD=replace-with-test-db-password
DB_TEST_PORT=5433

ALLOWED_HOSTS=localhost 127.0.0.1 [::1]
DEBUG=1

DJANGO_PORT=8002
BASE_URL=http://localhost:8002
NGINX_PORT=8083

# Inventory assistant (read-only)
OPENAI_API_KEY=replace-with-openai-api-key
# Models: gpt-5.6-luna, gpt-5.6-terra, gpt-5.6-sol
OPENAI_MODEL=gpt-5.6-luna
# Reasoning effort: none, low, medium, high, xhigh, max
OPENAI_REASONING_EFFORT=high
# Estimated USD prices per million tokens. Set rates for every model you enable.
OPENAI_COST_GPT_5_6_LUNA_INPUT_PER_MILLION=0.20
OPENAI_COST_GPT_5_6_LUNA_CACHED_INPUT_PER_MILLION=0.02
OPENAI_COST_GPT_5_6_LUNA_OUTPUT_PER_MILLION=1.20
OPENAI_COST_GPT_5_6_TERRA_INPUT_PER_MILLION=2.00
OPENAI_COST_GPT_5_6_TERRA_CACHED_INPUT_PER_MILLION=0.20
OPENAI_COST_GPT_5_6_TERRA_OUTPUT_PER_MILLION=12.00
OPENAI_COST_GPT_5_6_SOL_INPUT_PER_MILLION=5.00
OPENAI_COST_GPT_5_6_SOL_CACHED_INPUT_PER_MILLION=0.50
OPENAI_COST_GPT_5_6_SOL_OUTPUT_PER_MILLION=30.00
